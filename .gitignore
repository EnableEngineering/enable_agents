# ── Python ───────────────────────────────────────────────────────────────────
__pycache__/
*.pyc
*.pyo
*.pyd
*.pyo
.Python

# ── Virtual environments ──────────────────────────────────────────────────────
venv/
env/
.venv/
.venv-win/
backend/venv/

# ── Environment / secrets ─────────────────────────────────────────────────────
.env
.env.local
.env.docker
backend/.env
frontend/.env

# ── Node.js ───────────────────────────────────────────────────────────────────
node_modules/
frontend/node_modules/
frontend/build/

# ── Data & generated files ────────────────────────────────────────────────────
data/
*.pkl
*.faiss
# Scope json exclusions tightly — broad *.json would hide agent manifests
**/data/*.json
**/uploads/*.json
# Exception: include frontend demo data (JSON files for easy editing)
!frontend/src/data/
!frontend/src/data/**

# ── Celery runtime ────────────────────────────────────────────────────────────
celerybeat-schedule
celerybeat.pid

# ── Flask / SQLAlchemy ────────────────────────────────────────────────────────
instance/
backend/instance/
*.db
*.sqlite3

# ── Uploads & temp ───────────────────────────────────────────────────────────
uploads/
temp_files/

# ── Test / coverage ───────────────────────────────────────────────────────────
.pytest_cache/
.coverage
htmlcov/
frontend/test-results/
frontend/playwright-report/
frontend/playwright/.cache/

# Eval harness output (regenerated each run, not source) - the fixtures,
# runner, and scoring code under backend/eval/ ARE real tracked source.
backend/eval/report.json
backend/eval/report.md

# ── OS & editor ───────────────────────────────────────────────────────────────
.DS_Store
Thumbs.db
*.log
.idea/
.vscode/
*.swp
*.swo
internal/
